NODEJS_HELPERS=0
# Optional canonical production origin. In Preview, omit this override to use its own URL.
AUTH_APP_ORIGIN=https://robetixvision.vercel.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=SET_IN_VERCEL_ONLY
SUPABASE_SERVICE_ROLE_KEY=SET_IN_VERCEL_ONLY
RECIPIENT_ENCRYPTION_KEY=SET_64_RANDOM_HEX_CHARACTERS_IN_VERCEL_ONLY
WHATSAPP_DAILY_LIMIT=100
META_ACCESS_TOKEN=SET_IN_VERCEL_ONLY
META_PHONE_ID=SET_IN_VERCEL_ONLY
META_GRAPH_VERSION=vXX.X
META_TEMPLATE_IMAGE=robetix_motion_image
META_TEMPLATE_TEXT=robetix_motion_text
META_TEMPLATE_LANGUAGE=en
META_APP_SECRET=SET_IN_VERCEL_ONLY
META_WEBHOOK_VERIFY_TOKEN=GENERATE_RANDOM_SECRET
CRON_SECRET=GENERATE_RANDOM_SECRET_AT_LEAST_32_BYTES

# Optional remote live video. Deploy relay/ separately; use the SAME fresh 32-byte hex secret there.
# Keep these server-side. Do not put these into public scripts or firmware.
LIVE_RELAY_URL=https://YOUR-RELAY.YOUR-SUBDOMAIN.workers.dev
LIVE_RELAY_SECRET=GENERATE_64_HEX_CHARACTERS
# Enable only after applying remote/migrations/003_camera_setup.sql.
CAMERA_SETUP_ENABLED=false
