{
  "functions": {
    "api/*.mjs": {
      "maxDuration": 60,
      "includeFiles": "service-origins.json"
    }
  },
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self' wss: https://*.workers.dev; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/reset-password"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "robetixvision.vercel.app"
        }
      ],
      "destination": "https://vision.robetix.com/:path*",
      "permanent": true
    }
  ]
}
